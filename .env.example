# Copie para .env e TROQUE todos os valores antes de subir em produção.
# Gere segredos com:  openssl rand -base64 48

POSTGRES_DB=avaliacao
POSTGRES_USER=semad
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria

# Assinatura das sessões do dashboard (mínimo 32 caracteres).
JWT_SECRET=troque-por-um-segredo-aleatorio-com-64-caracteres-ou-mais

# Chave que o app do totem envia no cabeçalho X-Totem-Key (mesmo valor de EXPO_PUBLIC_TOTEM_KEY).
TOTEM_API_KEY=troque-esta-chave-do-totem

# Senhas INICIAIS dos dois perfis. Viram hash bcrypt no primeiro start; depois disso,
# troque com:  docker compose exec api npm run set-password -- <usuario>
ATENDIMENTO_USER=atendimento
ATENDIMENTO_PASSWORD=TroqueEstaSenha@Atendimento
ASSESSORIA_USER=assessoria
ASSESSORIA_PASSWORD=TroqueEstaSenha@Assessoria

# true somente quando o dashboard estiver atrás de HTTPS.
COOKIE_SECURE=false

# Porta do dashboard no servidor (o totem também usa esta porta: http://IP:8080).
DASHBOARD_PORT=8080
